{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {"type": "integer", "const": 1},
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "deadlineSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "adapter": {
      "type": "object",
      "required": ["mode", "allowedNamespaces", "kafkaRest", "credentialBroker", "egressGateway"],
      "properties": {
        "mode": {"enum": ["safe-unknown", "kubernetes"]},
        "allowedNamespaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^asv-[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}
        },
        "kafkaRest": {
          "type": "object",
          "required": ["enabled", "url", "topic", "consumerGroup", "consumerInstance", "bearerTokenSecretKey"],
          "properties": {
            "enabled": {"type": "boolean"},
            "url": {"type": "string"},
            "topic": {"type": "string", "minLength": 1},
            "consumerGroup": {"type": "string", "minLength": 1},
            "consumerInstance": {"type": "string", "minLength": 1},
            "bearerTokenSecretKey": {"type": "string", "minLength": 1}
          }
        },
        "credentialBroker": {
          "type": "object",
          "required": ["enabled", "url", "testResource", "controllerTokenSecretKey"],
          "properties": {
            "enabled": {"type": "boolean"},
            "url": {"type": "string"},
            "testResource": {"type": "string", "minLength": 1},
            "controllerTokenSecretKey": {"type": "string", "minLength": 1}
          }
        },
        "egressGateway": {
          "type": "object",
          "required": ["enabled", "url", "testDestination", "controllerTokenSecretKey"],
          "properties": {
            "enabled": {"type": "boolean"},
            "url": {"type": "string"},
            "testDestination": {"type": "string"},
            "controllerTokenSecretKey": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["existingSecret", "authSecretKey", "signingKeyKey"],
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1},
        "authSecretKey": {"type": "string", "minLength": 1},
        "signingKeyKey": {"type": "string", "minLength": 1}
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "size": {"type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$"}
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "kubernetesAdapter": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"}
          },
          "required": ["enabled"]
        }
      }
    }
  },
  "required": ["replicaCount", "image", "controller", "adapter", "secrets", "persistence", "rbac"]
}
